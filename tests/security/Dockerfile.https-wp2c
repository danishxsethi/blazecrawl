FROM mcr.microsoft.com/playwright/python:v1.63.0-jammy
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libnss3-tools openssl ca-certificates iproute2 && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir playwright==1.63.0 pytest pytest-asyncio
WORKDIR /workspace/oss-core
COPY oss-core/ /workspace/oss-core/
RUN python -m pip install --no-cache-dir -e ".[dev]" 2>&1 | tail -5
